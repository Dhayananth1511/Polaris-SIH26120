# ── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000

# ── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://polaris:changeme@localhost:5432/polaris_db

# ── JWT Secrets ──────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_ACCESS_SECRET=CHANGE_ME_USE_LONG_RANDOM_SECRET_64_BYTES_MINIMUM
JWT_REFRESH_SECRET=CHANGE_ME_USE_DIFFERENT_LONG_RANDOM_SECRET_64_BYTES

# ── Token Expiry ─────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRES_IN=15       # minutes
REFRESH_TOKEN_EXPIRES_IN=7       # days

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Brute-force / Lockout ────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=15

# ── Bootstrap Admin (run scripts/bootstrap_admin.py ONCE on first deploy) ────
# Remove or blank these after the first successful admin creation.
BOOTSTRAP_ADMIN_ID=OIL-AD-0001
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_BEFORE_RUNNING
BOOTSTRAP_ADMIN_NAME=System Administrator
